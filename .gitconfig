# ~/.gitconfig — read by git every time it runs.
#
# You already created this file in Step 2 with `git config --global ...`.
# Those commands just write lines into this file. You can edit it directly,
# or open it in your editor with:   git config --global --edit

[user]
	name = Your Name
	email = you@example.com

[init]
	defaultBranch = main

[core]
	editor = vim

[pull]
	rebase = true

[color]
	ui = auto

# Aliases: `git st` runs `git status`, and so on.
[alias]
	st = status
	br = branch
	sw = switch
	last = log -1 HEAD --stat
	# One line per commit, with a branch graph:
	lg = log --oneline --graph --decorate --all
	# Undo `git add file` (keeps your edits, just unstages them):
	unstage = restore --staged --
